# ---------------------------------------------------------------------------
# EpiRoute configuration template
#
# Copy to `.env` (`just setup` does this for you) and adjust as needed.
# `.env` is git-ignored and must never contain committed credentials.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
# "development" enables the interactive API docs and verbose errors.
EPIROUTE_ENV=development
EPIROUTE_LOG_LEVEL=INFO

# Origins allowed to call the API from a browser (comma-separated).
EPIROUTE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL (required) -------------------------------------------------
# These values are consumed both by docker-compose.yml and by the backend.
POSTGRES_USER=epiroute
POSTGRES_PASSWORD=epiroute
POSTGRES_DB=epiroute
POSTGRES_HOST=localhost
POSTGRES_PORT=55433

# Optional: a full SQLAlchemy URL. When set it overrides the POSTGRES_* parts
# above. Useful for a managed database.
# EPIROUTE_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/epiroute

# --- TinyFish (optional integration) --------------------------------------
# Server-side only. Never expose this key to the frontend.
# Without a key the ingestion pipeline runs in its documented `direct_fetch`
# mode: it reads WHO pages over plain HTTPS and extracts fields with the
# deterministic parser instead of the TinyFish Agent.
TINYFISH_API_KEY=
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai
TINYFISH_AGENT_URL=https://agent.tinyfish.ai
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
# Shared secret used to authenticate TinyFish Monitor webhook deliveries.
TINYFISH_WEBHOOK_SECRET=

# --- Ingestion ------------------------------------------------------------
# Hard cap on records fetched per ingestion run, so an accidental full-archive
# pull cannot run away.
EPIROUTE_INGEST_MAX_RECORDS=120
EPIROUTE_HTTP_TIMEOUT_SECONDS=30

# --- Data directories -----------------------------------------------------
# Relative paths are resolved from the repository root.
EPIROUTE_DATA_DIR=data
